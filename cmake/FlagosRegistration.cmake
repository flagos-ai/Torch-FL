# Select the generated m.impl fragments for this build. The caller has already
# resolved the platform, kernel switches and SDK availability.
function(flagos_write_registration aten_dir output)
  string(JSON _registration GET "${_flagos_platforms}"
         accelerators "${FLAGOS_PLATFORM_ID}" registration)
  foreach(_kind IN ITEMS base vendor flaggems tileops native_host)
    string(JSON _${_kind} ERROR_VARIABLE _missing GET "${_registration}" "${_kind}")
    if(_missing)
      set(_${_kind} "")
    endif()
  endforeach()

  set(_content "// Generated by CMake for the selected ATen registration.\n")
  if(FLAGOS_BUILD_TILEOPS AND _tileops)
    set(_fragments "${_tileops}")
    string(APPEND _content "#define FLAGOS_REGISTER_TILEOPS 1\n")
  else()
    set(_fragments "${_base}")
    if(FLAGOS_BUILD_VENDOR AND (NOT _flagos_is_musa OR FLAGOS_MUSA_VENDOR_SLOT))
      list(APPEND _fragments ${_vendor})
    endif()
    if(FLAGOS_BUILD_FLAGGEMS)
      list(APPEND _fragments ${_flaggems})
      if(FLAGOS_NATIVE_HOSTS)
        list(APPEND _fragments ${_native_host})
      endif()
    endif()
  endif()

  foreach(_fragment IN LISTS _fragments)
    if(NOT EXISTS "${aten_dir}/${_fragment}")
      message(FATAL_ERROR "${FLAGOS_PLATFORM_ID}: missing ATen registration fragment ${_fragment}")
    endif()
    string(APPEND _content "#include \"aten/${_fragment}\"\n")
  endforeach()
  file(CONFIGURE OUTPUT "${output}" CONTENT "${_content}" @ONLY)
endfunction()
