mcError_t Launch(Operation operation, const Batch& batch, mcStream_t stream) {
  if (!batch.blocks) return mcSuccess;
  switch (operation) {
    case Operation::Lerp:
      Pointwise<Operation::Lerp, 1><<<batch.blocks, 256, 0, stream>>>(batch);
