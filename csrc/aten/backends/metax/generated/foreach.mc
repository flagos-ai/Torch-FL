__device__ float ToFloat(uint16_t value) {
  return __uint_as_float(static_cast<uint32_t>(value) << 16);
}

__device__ uint16_t RoundBFloat16(float value) {
  const auto bits = __float_as_uint(value);
  if ((bits & 0x7fffffff) > 0x7f800000) {
    return static_cast<uint16_t>((bits >> 16) | 0x40);
  }
  return static_cast<uint16_t>((bits + 0x7fff + ((bits >> 16) & 1)) >> 16);
}

template <Operation op>
__device__ float Apply(float x, float y, float z, float alpha) {
  if constexpr (op == Operation::Lerp) {
    const float delta = y - x;
    return fabsf(alpha) < 0.5f ? fmaf(alpha, delta, x)
                              : fmaf(alpha - 1.0f, delta, y);
  }
  else if constexpr (op == Operation::Addcmul) {
    return fmaf(alpha, y * z, x);
  }
  else if constexpr (op == Operation::Addcdiv) {
    return fmaf(alpha, y / z, x);
  }
  else if constexpr (op == Operation::Multiply) {
    return x * alpha;
  }
  else if constexpr (op == Operation::Add) {
    return x + alpha;
  }
  else if constexpr (op == Operation::Divide) {
    return x / alpha;
  }
  else if constexpr (op == Operation::Sqrt) {
    return sqrtf(y);
  }
}

template <Operation op, int inputs>
__global__ void Pointwise(Batch batch) {
