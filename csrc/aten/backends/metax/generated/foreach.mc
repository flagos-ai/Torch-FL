      break;
    case Operation::Multiply:
      Pointwise<Operation::Multiply, 0><<<batch.blocks, 256, 0, stream>>>(batch);
      break;
    case Operation::Add:
      Pointwise<Operation::Add, 0><<<batch.blocks, 256, 0, stream>>>(batch);
      break;
    case Operation::Divide:
      Pointwise<Operation::Divide, 0><<<batch.blocks, 256, 0, stream>>>(batch);
      break;
    case Operation::Sqrt:
      Pointwise<Operation::Sqrt, 1><<<batch.blocks, 256, 0, stream>>>(batch);
