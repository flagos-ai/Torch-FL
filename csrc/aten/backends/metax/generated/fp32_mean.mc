template <unsigned vector_width, bool average>
__global__ void ReduceLast(const float* input, float* output, unsigned columns) {
  __shared__ float partials[512];
  const unsigned lane = threadIdx.x;
  const unsigned lanes = blockDim.x;
  const float* row = input + static_cast<int64_t>(blockIdx.x) * columns;
  float value = 0;
  for (unsigned i = vector_width * lane; i < columns; i += vector_width * lanes) {
#pragma unroll
    for (unsigned component = 0; component < vector_width; ++component)
      value += row[i + component];
  }
  partials[lane] = value;
  __syncthreads();

  // This produces the same accumulation order as the verified FlagGems
  // reduction with the MACA lane permutation applied to its input.
  const unsigned warp = lanes < 64 ? lanes : 64;
  for (unsigned step = lanes / 2; step >= warp; step /= 2) {
    if (lane < step) partials[lane] += partials[lane + step];
    __syncthreads();
  }
  for (unsigned step = 1; step < warp; step *= 2) {
    if (lane < warp && lane % (2 * step) == 0)
      partials[lane] += partials[lane + step];
    __syncthreads();
  }
  if (lane == 0) {
    output[blockIdx.x] = average ? partials[0] * (1.0f / columns) : partials[0];
  }
}

template <bool average>
mcError_t Launch(const float* input, float* output, unsigned rows, unsigned columns,
                 mcStream_t stream) {
  constexpr unsigned max_threads = 512;
  const unsigned initial_width = columns == 128 ? 16 : 64;
  const unsigned max_height = std::min(rows, max_threads / initial_width);
  unsigned height = 1;
  while (height * 2 <= max_height) height *= 2;
  if (columns == 128) {
    const auto lanes = std::min(columns, max_threads / height);
    ReduceLast<1, average><<<rows, lanes, 0, stream>>>(input, output, columns);
  } else {
    const auto lanes = std::min(columns / 4, max_threads / height);
    ReduceLast<4, average><<<rows, lanes, 0, stream>>>(input, output, columns);
  }
  return mcGetLastError();
}

}  // namespace

mcError_t Mean(const float* input, float* output, unsigned rows, unsigned columns,
