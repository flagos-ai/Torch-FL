constexpr unsigned kAttentionLanes = 64;
constexpr unsigned kWideThreads = 512;
constexpr unsigned kWideGroupSize = 64;
constexpr unsigned kWideGroups = kWideThreads / kWideGroupSize;
constexpr unsigned kWideVector = 4;

template <bool sum>
__device__ float ReduceAttentionRow(float value, float* partials) {
  const unsigned lane = threadIdx.x;
  partials[lane] = value;
  __syncthreads();
  for (unsigned step = kAttentionLanes / 2; step > 0; step /= 2) {
    if (lane < step) {
      partials[lane] = sum ? partials[lane] + partials[lane + step]
                           : fmaxf(partials[lane], partials[lane + step]);
    }
    __syncthreads();
  }
  const float result = partials[0];
  __syncthreads();
  return result;
}

template <bool backward>
__global__ void Softmax128Rows(const float* input, const float* output, float* result) {
  __shared__ float partials[kAttentionLanes];
  const unsigned lane = threadIdx.x;
  const auto offset = static_cast<int64_t>(blockIdx.x) * kAttentionSoftmaxWidth;
  input += offset;
  result += offset;
  if constexpr (backward) {
    output += offset;
    const unsigned other = lane + kAttentionLanes;
    const float left = __fmul_rn(input[lane], output[lane]);
    const float right = __fmul_rn(input[other], output[other]);
    const float total = ReduceAttentionRow<true>(__fadd_rn(left, right), partials);
    // The eager backward reduces the rounded products and then uses an FMA.
    result[lane] = __fmaf_rn(-output[lane], total, left);
    result[other] = __fmaf_rn(-output[other], total, right);
  } else {
    const unsigned first = 2 * lane;
    const float left = input[first];
    const float right = input[first + 1];
    const float maximum = ReduceAttentionRow<false>(fmaxf(left, right), partials);
    const float a = __expf(left - maximum);
    const float b = __expf(right - maximum);
    const float total = ReduceAttentionRow<true>(a + b, partials);
    // MACA's persistent softmax uses the hardware reciprocal at FP32 precision.
    const float inverse = __fdividef(1.0f, total);
    result[first] = a * inverse;
    result[first + 1] = b * inverse;
  }
}

__device__ float SumWideRow(float value, float* partials, float* groups) {
  const unsigned lane = threadIdx.x;
  partials[lane] = value;
  __syncthreads();
  if (lane < kWideGroups) {
    const float* first = partials + lane * kWideGroupSize;
    float total = first[0];
    for (unsigned i = 1; i < kWideGroupSize; ++i) total += first[i];
    groups[lane] = total;
  }
  __syncthreads();
  if (lane == 0) {
    float total = groups[0];
    for (unsigned i = 1; i < kWideGroups; ++i) total += groups[i];
    groups[0] = total;
  }
  __syncthreads();
  return groups[0];
}

__global__ void WideLogSoftmaxRows(const float* input, float* result, unsigned columns) {
  __shared__ float partials[kWideThreads];
  __shared__ float groups[kWideGroups];
  const unsigned lane = threadIdx.x;
  const auto offset = static_cast<int64_t>(blockIdx.x) * columns;
  input += offset;
  result += offset;
  float maximum = -INFINITY;
  for (unsigned i = lane; i < columns; i += kWideThreads) {
    maximum = fmaxf(maximum, input[i]);
  }
  partials[lane] = maximum;
  __syncthreads();
  for (unsigned step = kWideThreads / 2; step > 0; step /= 2) {
    if (lane < step) partials[lane] = fmaxf(partials[lane], partials[lane + step]);
    __syncthreads();
  }
  maximum = partials[0];
  __syncthreads();

  // MACA Torch sums four adjacent elements per lane, followed by a serial
  // FP32 sum within each 64-lane group and across the eight group totals.
  constexpr unsigned stride = kWideThreads * kWideVector;
  const unsigned aligned_columns = columns / stride * stride;
  float sum = 0.0f;
  for (unsigned i = kWideVector * lane; i < aligned_columns; i += stride) {
#pragma unroll
    for (unsigned j = 0; j < kWideVector; ++j) sum += __expf(input[i + j] - maximum);
  }
  for (unsigned i = aligned_columns + lane; i < columns; i += kWideThreads) {
    sum += __expf(input[i] - maximum);
  }
  const float log_sum = __logf(SumWideRow(sum, partials, groups));
  for (unsigned i = lane; i < columns; i += kWideThreads) {
    result[i] = (input[i] - maximum) - log_sum;
  }
}

__device__ float LoadBFloat16(uint16_t value) {
  return __uint_as_float(static_cast<uint32_t>(value) << 16);
}

__device__ uint16_t StoreBFloat16(float value) {
  const uint32_t bits = __float_as_uint(value);
  if ((bits & 0x7fffffffu) > 0x7f800000u) return 0x7fffu;
  return static_cast<uint16_t>((bits + 0x7fffu + ((bits >> 16) & 1u)) >> 16);
}

template <bool backward>
__global__ void SiluElements(const uint16_t* input, const uint16_t* grad,
                             uint16_t* result, int64_t count) {
  const auto index = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
  if (index >= count) return;
  const float x = LoadBFloat16(input[index]);
  float value;
  if constexpr (backward) {
    const float sigmoid = 1.0f / (1.0f + __expf(-x));
    value = (LoadBFloat16(grad[index]) * sigmoid) * (1.0f + x * (1.0f - sigmoid));
  } else {
    // MACA Torch rounds the fast division before converting to BF16.
    value = __fdividef(x, 1.0f + expf(-x));
  }
  result[index] = StoreBFloat16(value);
}

