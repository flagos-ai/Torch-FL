musaError_t Launch(Operation operation, const Batch& batch, musaStream_t stream) {
  if (!batch.blocks) return musaSuccess;
  switch (operation) {
    case Operation::Lerp:
      Pointwise<Operation::Lerp><<<batch.blocks, 256, 0, stream>>>(batch);
      break;
    case Operation::Addcmul:
      Pointwise<Operation::Addcmul><<<batch.blocks, 256, 0, stream>>>(batch);
      break;
    case Operation::Addcdiv:
      Pointwise<Operation::Addcdiv><<<batch.blocks, 256, 0, stream>>>(batch);
      break;
  }
