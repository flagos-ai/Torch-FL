# Single source of truth for the version pins the set_env_*.sh scripts use.
#
# Sourced by each script after REPO_ROOT is set, so bumping a pin is one edit
# here instead of seven across the platform scripts. Each value is the DEFAULT a
# script falls back to when its TORCH_FL_* override is unset -- the override
# still wins, and the scripts keep their TORCH_FL_* names.
#
# Not executable: a plain assignment file meant to be sourced.

# --- Shared pins (identical on every platform) ---
CPU_TORCH_VERSION_DEFAULT=2.10.0
CPU_TORCH_INDEX_URL_DEFAULT=https://download.pytorch.org/whl/cpu
# A mirror of the index above, holding the same torch 2.10.0+cpu wheels. The pin
# is authoritative and stays the fallback; install_cpu_torch measures both and
# installs from whichever is faster from the pod, because the pin is offshore and
# the pods measure 150-480 kB/s there, i.e. 5 minutes on Ascend and 17-21 minutes
# on the GCU and Kunlunxin build jobs, for a 146-190 MB wheel. Set
# TORCH_FL_CPU_TORCH_MIRROR_INDEX_URL empty to disable the mirror.
CPU_TORCH_MIRROR_INDEX_URL_DEFAULT=https://mirror.sjtu.edu.cn/pytorch-wheels/cpu
FLAGTREE_INDEX_URL_DEFAULT=https://resource.flagos.net/repository/flagos-pypi-hosted/simple
FLAGTREE_MIN_GLIBC_DEFAULT=2.38
FLAGGEMS_VERSION_DEFAULT=5.4.0
FLAGOS_WHEEL_ROOT_DEFAULT=https://resource.flagos.net/repository
PIP_INDEX_URL_DEFAULT=https://pypi.org/simple
# The uploader the release jobs install on each vendor runner. Pinned like
# everything else here: a release must not depend on whichever twine PyPI is
# serving that day, and 7.0.0 is the version the v2.10.0rc1 uploads were
# completed with.
TWINE_VERSION_DEFAULT=7.0.0

# --- FlagTree wheels (per-vendor builds of the same Triton line) ---
FLAGTREE_VERSION_cuda=0.7.0
FLAGTREE_VERSION_ascend=0.7.0+ascend3.5
FLAGTREE_VERSION_dcu=0.7.0+hcu3.6
FLAGTREE_VERSION_gcu=0.7.0+enflame3.6
FLAGTREE_VERSION_metax=0.7.0.post2+metax3.6
FLAGTREE_VERSION_musa=0.7.0+mthreads3.6
FLAGTREE_VERSION_ppu=0.7.0+ppu3.6

# The Python each platform's FlagTree is published for. Not a choice: a FlagTree
# build exists for exactly one cp tag, and torch_fl links it, so the interpreter
# that can install the wheel is fixed per platform. setup.py reads these as the
# wheel's Requires-Python so a wrong interpreter is rejected at resolve time
# instead of at `import torch_fl`.
FLAGTREE_PYTHON_VERSION_cuda=3.12
FLAGTREE_PYTHON_VERSION_gcu=3.12
FLAGTREE_PYTHON_VERSION_metax=3.12
FLAGTREE_PYTHON_VERSION_ppu=3.12
FLAGTREE_PYTHON_VERSION_dcu=3.10
FLAGTREE_PYTHON_VERSION_musa=3.10
FLAGTREE_PYTHON_VERSION_ascend=3.11

# Published FlagCX wheels. Only install a native build after its CI image and
# host driver match the corresponding vendor toolkit version.
HYGON_INDEX_URL_DEFAULT=https://resource.flagos.net/repository/flagos-pypi-hygon/simple
FLAGCX_VERSION_dcu=0.14.0+dtk2604
FLAGCX_VERSION_musa=0.14.0+musa5.2.0
FLAGCX_VERSION_cuda=0.14.0+cuda13.3
FLAGCX_VERSION_metax=0.14.0+maca3.8.1.3
FLAGCX_VERSION_gcu=0.14.0+tops1.9.10
FLAGCX_VERSION_ascend=0.14.0+cann9.0.0
# --- Other per-platform pins ---
# The CUDA build of PyTorch a bootstrap vendor interpreter is created with.
VENDOR_TORCH_INDEX_URL_cuda=https://download.pytorch.org/whl/cu130
