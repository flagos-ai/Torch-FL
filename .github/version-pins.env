# Single source of truth for the version pins the set_env_*.sh scripts use.
#
# Sourced by each script after REPO_ROOT is set, so bumping a pin is one edit
# here instead of seven across the platform scripts. Each value is the DEFAULT a
# script falls back to when its TORCH_FL_* override is unset -- the override
# still wins, and the scripts keep their TORCH_FL_* names.
#
# Not executable: a plain assignment file meant to be sourced.

# --- Shared pins (identical on every platform) ---
CPU_TORCH_VERSION_DEFAULT=2.10.0
CPU_TORCH_INDEX_URL_DEFAULT=https://download.pytorch.org/whl/cpu
FLAGTREE_INDEX_URL_DEFAULT=https://resource.flagos.net/repository/flagos-pypi-hosted/simple
# FlagTree is published as cp312-only source-free wheels, so the isolated test
# environment runs Python 3.12 and the accelerator interpreter must match it.
FLAGTREE_PYTHON_VERSION_DEFAULT=3.12
FLAGTREE_MIN_GLIBC_DEFAULT=2.38
FLAGGEMS_REPO_DEFAULT=https://github.com/flagos-ai/FlagGems.git
PIP_INDEX_URL_DEFAULT=https://pypi.org/simple

# TEMPORARY PIN -- revert to `master` once upstream fixes flagos-ai/FlagGems:
# d312aa02 (2026-09-16) added ("argsort.stable", argsort_stable) to the
# module-level _FULL_CONFIG in flag_gems/__init__.py, but argsort_stable is only
# defined by the kunlunxin backend package, so `import flag_gems` raises
# NameError on every other vendor. 437ba393 is the last good master (its parent).
FLAGGEMS_REVISION_DEFAULT=437ba39387ddc681dc884259ef9dbf0c1802bccc

# --- FlagTree wheels (per-vendor builds of the same Triton line) ---
FLAGTREE_VERSION_cuda=0.6.2a2
FLAGTREE_VERSION_ascend=0.6.2a1+ascend3.5
FLAGTREE_VERSION_dcu=0.6.2a1+hcu3.6
FLAGTREE_VERSION_gcu=0.6.1+enflame3.6
FLAGTREE_VERSION_metax=0.6.1+metax3.6
FLAGTREE_VERSION_musa=0.6.2a3+mthreads3.6
FLAGTREE_VERSION_ppu=0.6.2a2+ppu3.6

# --- Other per-platform pins ---
# The CUDA build of PyTorch a bootstrap vendor interpreter is created with.
VENDOR_TORCH_INDEX_URL_cuda=https://download.pytorch.org/whl/cu130
